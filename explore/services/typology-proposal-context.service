[Unit]
Description=Typology proposal context JPEG cache

[Service]
EnvironmentFile=-%h/.config/typology-machine/deployment.env
Type=simple
WorkingDirectory=%h/projects/typology-machine
ExecStart=%h/projects/typology-machine/.venv/bin/python -u explore/proposal_context.py --host 127.0.0.1 --port 8793 --decoders 1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Restart=on-failure
RestartSec=3
Nice=10

[Install]
WantedBy=default.target
