# Retired 2026-10-31; kept for reference (see docs/graffiti.md).
[Unit]
Description=Typology graffiti generation API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/typology-machine
EnvironmentFile=-%h/.config/typology-machine/graffiti.env
Environment=TYPOLOGY_GRAFFITI_HOME=/mnt/data/projects/typology-machine/graffiti-flux2-captioned-20261014
ExecStart=/mnt/data/projects/typology-machine/graffiti-flux2/venv/bin/python explore/graffiti_api.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
Nice=10
Environment=OMP_NUM_THREADS=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
