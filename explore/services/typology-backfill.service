[Unit]
Description=People and pets backfill after the Apple category pass
[Service]
EnvironmentFile=-%h/.config/typology-machine/deployment.env
Type=oneshot
WorkingDirectory=%h/projects/typology-machine
ExecStart=%h/projects/typology-machine/.venv/bin/python -u explore/backfill_people_pets.py
Environment=OPENBLAS_NUM_THREADS=1
Nice=10
TimeoutStartSec=infinity
TimeoutStopSec=120
