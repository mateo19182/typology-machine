[Unit]
Description=Read-only Typology background progress and health check

[Service]
EnvironmentFile=-%h/.config/typology-machine/deployment.env
Type=oneshot
WorkingDirectory=%h/projects/typology-machine
ExecStart=%h/projects/typology-machine/.venv/bin/python -u explore/background_watch.py
Nice=15
TimeoutStartSec=90
