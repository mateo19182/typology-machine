[Unit]
Description=Refresh Typology object layer snapshot

[Service]
EnvironmentFile=-%h/.config/typology-machine/deployment.env
Type=oneshot
WorkingDirectory=%h/projects/typology-machine
ExecStart=%h/projects/typology-machine/.venv/bin/python -u explore/export_layers.py coruna --run data/coruna/apple/multicategory/765844a02f75 --extra-run data/coruna/apple/multicategory/8b6f53a1131e --extra-run data/coruna/apple/multicategory/91bd4ea5ae4e --if-changed --prune-hours 24
Environment=OPENBLAS_NUM_THREADS=1
ExecStartPost=%h/projects/typology-machine/.venv/bin/python -u explore/object_api.py build
Nice=10
TimeoutStartSec=900
