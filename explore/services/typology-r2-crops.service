[Unit]
Description=Publish referenced Typology crops to R2 and verify public delivery
ConditionPathExists=%h/.config/typology-machine/r2.env

[Service]
EnvironmentFile=-%h/.config/typology-machine/deployment.env
Type=oneshot
WorkingDirectory=%h/projects/typology-machine
ExecStart=%h/projects/typology-machine/.venv/bin/python -u explore/publish_crops_r2.py --activate --workers 32
Nice=10
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=120

