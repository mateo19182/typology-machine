{
	auto_https off
	admin off
}

http://:8790 {
	root * {$TYPOLOGY_SITE_ROOT:./data/coruna/site}
	encode zstd gzip
	reverse_proxy /api/* 127.0.0.1:8794
	reverse_proxy /proposal-context/* 127.0.0.1:8793
	file_server
	@assets path /img/* /ctx/*
	header @assets Cache-Control "public, max-age=604800"
	header /data.json Cache-Control "public, max-age=300"
	header /app.js Cache-Control "no-cache"
}
