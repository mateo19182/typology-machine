# Mapillary scripts load .env from the repository root. Quote tokens containing |.
MAPILLARY_TOKEN=''

# Optional deployment settings: export these in your shell or put them in
# ~/.config/typology-machine/deployment.env for the systemd examples.
TYPOLOGY_PUBLIC_URL=http://127.0.0.1:8790
TYPOLOGY_SITE_ROOT=./data/coruna/site
TYPOLOGY_DATA_DISK=/mnt/data

# Optional R2 uploader: put these in ~/.config/typology-machine/r2.env (chmod 600).
R2_ACCOUNT_ID=
R2_BUCKET=typology-crops
R2_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
